import arcpyclass Toolbox:    def __init__(self):        self.label = "Gap Auto Fixer"        self.alias = "gap_auto_fixer"        self.tools = [GapAutoFixer]class GapAutoFixer:    def __init__(self):        self.label = "Gap Auto Fixer"        self.description = (            "Automatically closes small gaps between "            "existing polygon boundaries."        )    def getParameterInfo(self):        input_boundary = arcpy.Parameter(            displayName="Input Boundary",            name="input_boundary",            datatype="GPFeatureLayer",            parameterType="Required",            direction="Input"        )        input_boundary.filter.list = ["Polygon"]        gap_layer = arcpy.Parameter(            displayName="Gap Layer",            name="gap_layer",            datatype="GPFeatureLayer",            parameterType="Required",            direction="Input"        )        gap_layer.filter.list = ["Polygon"]        tolerance = arcpy.Parameter(            displayName="Maximum Gap Width",            name="maximum_gap_width",            datatype="GPLinearUnit",            parameterType="Required",            direction="Input"        )        tolerance.value = "2 Meters"        output = arcpy.Parameter(            displayName="Output Boundary",            name="output_boundary",            datatype="DEFeatureClass",            parameterType="Required",            direction="Output"        )        return [            input_boundary,            gap_layer,            tolerance,            output        ]    def isLicensed(self):        return True    def updateParameters(self, parameters):        return    def updateMessages(self, parameters):        return    def execute(self, parameters, messages):        boundary = parameters[0].valueAsText        gaps = parameters[1].valueAsText        tolerance_text = parameters[2].valueAsText        output = parameters[3].valueAsText        # =====================================================        # TOLERANCE        # =====================================================        try:            tolerance = float(                tolerance_text.split()[0]            )        except Exception:            raise arcpy.ExecuteError(                "Invalid tolerance. Use for example: 2 Meters"            )        arcpy.AddMessage("")        arcpy.AddMessage(            "================================================"        )        arcpy.AddMessage(            "             GAP AUTO FIXER"        )        arcpy.AddMessage(            "================================================"        )        arcpy.AddMessage(            "Boundary: " + boundary        )        arcpy.AddMessage(            "Gaps: " + gaps        )        arcpy.AddMessage(            "Tolerance: "            + str(tolerance)            + " meters"        )        # =====================================================        # CHECK INPUT        # =====================================================        if not arcpy.Exists(boundary):            raise arcpy.ExecuteError(                "Input Boundary does not exist."            )        if not arcpy.Exists(gaps):            raise arcpy.ExecuteError(                "Gap Layer does not exist."            )        # =====================================================        # CRS        # =====================================================        boundary_sr = (            arcpy.Describe(boundary)            .spatialReference        )        gap_sr = (            arcpy.Describe(gaps)            .spatialReference        )        arcpy.AddMessage("")        arcpy.AddMessage(            "Boundary CRS: "            + boundary_sr.name        )        arcpy.AddMessage(            "Gap CRS: "            + gap_sr.name        )        if (            boundary_sr.factoryCode            != gap_sr.factoryCode        ):            raise arcpy.ExecuteError(                "Boundary and Gap layers must have "                "the same coordinate system."            )        # =====================================================        # COPY INPUT        # =====================================================        arcpy.AddMessage("")        arcpy.AddMessage(            "Creating output..."        )        if arcpy.Exists(output):            arcpy.management.Delete(                output            )        arcpy.management.CopyFeatures(            boundary,            output        )        # =====================================================        # OID FIELD        # =====================================================        oid_field = (            arcpy.Describe(output)            .OIDFieldName        )        # =====================================================        # COUNTS        # =====================================================        total_boundary = int(            arcpy.management.GetCount(                output            )[0]        )        total_gaps = int(            arcpy.management.GetCount(                gaps            )[0]        )        arcpy.AddMessage(            "Boundary features: "            + str(total_boundary)        )        arcpy.AddMessage(            "Gap features: "            + str(total_gaps)        )        # =====================================================        # BUILD POLYGON CACHE        #        # This avoids repeatedly reading the feature class.        # =====================================================        arcpy.AddMessage("")        arcpy.AddMessage(            "Reading boundary geometries..."        )        polygons = {}        with arcpy.da.SearchCursor(            output,            [oid_field, "SHAPE@"]        ) as cursor:            for oid, geometry in cursor:                if geometry is None:                    continue                polygons[oid] = geometry        arcpy.AddMessage(            "Loaded "            + str(len(polygons))            + " polygons."        )        # =====================================================        # PROCESS GAPS        # =====================================================        fixed = 0        skipped = 0        failed = 0        with arcpy.da.SearchCursor(            gaps,            ["OID@", "SHAPE@"]        ) as gap_cursor:            for gap_oid, gap in gap_cursor:                arcpy.AddMessage("")                arcpy.AddMessage(                    "----------------------------------------"                )                arcpy.AddMessage(                    "Processing gap: "                    + str(gap_oid)                )                if gap is None:                    arcpy.AddWarning(                        "Gap geometry is NULL."                    )                    skipped += 1                    continue                # =================================================                # GAP AREA                # =================================================                try:                    area = abs(gap.area)                except Exception:                    arcpy.AddWarning(                        "Could not calculate gap area."                    )                    failed += 1                    continue                if area <= 0:                    arcpy.AddWarning(                        "Gap has zero area."                    )                    skipped += 1                    continue                # =================================================                # GAP PERIMETER                # =================================================                try:                    perimeter = gap.length                except Exception:                    arcpy.AddWarning(                        "Could not calculate gap perimeter."                    )                    failed += 1                    continue                if perimeter <= 0:                    skipped += 1                    continue                # =================================================                # ESTIMATED WIDTH                # =================================================                width = (                    2.0 * area / perimeter                )                arcpy.AddMessage(                    "Gap area: "                    + str(round(area, 4))                    + " m²"                )                arcpy.AddMessage(                    "Estimated gap width: "                    + str(round(width, 4))                    + " m"                )                # =================================================                # TOLERANCE                # =================================================                if width > tolerance:                    arcpy.AddMessage(                        "Skipped - exceeds tolerance."                    )                    skipped += 1                    continue                # =================================================                # FIND NEAREST POLYGON                # =================================================                try:                    gap_boundary = gap.boundary()                except Exception as e:                    arcpy.AddWarning(                        "Cannot create gap boundary: "                        + str(e)                    )                    failed += 1                    continue                nearest_oid = None                nearest_distance = float("inf")                for oid, polygon in polygons.items():                    try:                        polygon_boundary = (                            polygon.boundary()                        )                        distance = (                            gap_boundary.distanceTo(                                polygon_boundary                            )                        )                    except Exception:                        continue                    if distance < nearest_distance:                        nearest_distance = distance                        nearest_oid = oid                # =================================================                # CHECK NEIGHBOR                # =================================================                if nearest_oid is None:                    arcpy.AddWarning(                        "No neighboring polygon found."                    )                    skipped += 1                    continue                arcpy.AddMessage(                    "Nearest polygon: "                    + str(nearest_oid)                )                arcpy.AddMessage(                    "Distance: "                    + str(round(                        nearest_distance,                        6                    ))                    + " m"                )                # =================================================                # FIX GAP                #                # Add the gap area to the nearest existing                # polygon.                # =================================================                try:                    old_polygon = polygons[                        nearest_oid                    ]                    new_polygon = (                        old_polygon.union(gap)                    )                    if new_polygon is None:                        raise RuntimeError(                            "Union returned None."                        )                    # Store updated geometry                    polygons[                        nearest_oid                    ] = new_polygon                    fixed += 1                    arcpy.AddMessage(                        "SUCCESS: Gap "                        + str(gap_oid)                        + " fixed."                    )                except Exception as e:                    arcpy.AddWarning(                        "Failed to fix gap "                        + str(gap_oid)                        + ": "                        + str(e)                    )                    failed += 1        # =====================================================        # WRITE ALL UPDATED POLYGONS        # =====================================================        arcpy.AddMessage("")        arcpy.AddMessage(            "Writing corrected geometries..."        )        with arcpy.da.UpdateCursor(            output,            [oid_field, "SHAPE@"]        ) as cursor:            for row in cursor:                oid = row[0]                if oid in polygons:                    row[1] = polygons[oid]                    cursor.updateRow(                        row                    )        # =====================================================        # FINAL        # =====================================================        arcpy.AddMessage("")        arcpy.AddMessage(            "================================================"        )        arcpy.AddMessage(            "             PROCESS COMPLETED"        )        arcpy.AddMessage(            "================================================"        )        arcpy.AddMessage(            "Total gaps : "            + str(total_gaps)        )        arcpy.AddMessage(            "Fixed      : "            + str(fixed)        )        arcpy.AddMessage(            "Skipped    : "            + str(skipped)        )        arcpy.AddMessage(            "Failed     : "            + str(failed)        )        arcpy.AddMessage("")        arcpy.AddMessage(            "Output: "            + output        )        arcpy.AddMessage("")        arcpy.AddMessage(            "Original boundary was not modified."        )        arcpy.AddMessage(            "Please run topology validation on the output."        )        # =====================================================        # ADD OUTPUT TO MAP        # =====================================================        try:            aprx = arcpy.mp.ArcGISProject(                "CURRENT"            )            maps = aprx.listMaps()            if maps:                maps[0].addDataFromPath(                    output                )                arcpy.AddMessage(                    "Output added to map."                )        except Exception as e:            arcpy.AddWarning(                "Could not add output to map: "                + str(e)            )        return